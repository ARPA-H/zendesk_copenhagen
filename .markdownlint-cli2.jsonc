{
  // Kept intentionally lenient to start clean against the existing docs
  // (PLAN.md, README.md, AGENTS.md, etc.) without a mass reformat.
  // Mirrors the relaxations already used in .github/skills/.markdownlint.json.
  "config": {
    "default": true,
    "MD013": false, // line-length: prose/tables here aren't wrapped to a column
    "MD024": { "siblings_only": true }, // allow repeated "## Session: ..." headings
    "MD033": false, // a few templates/docs embed raw HTML intentionally
    "MD041": false // not every doc starts with a top-level heading (e.g. CHANGELOG.md)
  },
  "ignores": [
    "node_modules",
    "assets",
    "CHANGELOG.md", // auto-generated by semantic-release
    "README.md", // near-zero-diff mirror of upstream's README, not ours to reformat
    ".github/skills" // synced from an external repo, has its own config already
  ]
}
