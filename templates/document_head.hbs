<script type="module" data-toast-host>
  // The toast host loads React and the Garden runtime (about 250 KB gzipped), so
  // a page loads it only when something can toast: a flash notification is
  // waiting in sessionStorage (written before a redirect; the key is
  // FLASH_NOTIFICATIONS_KEY in src/modules/shared/notifications/constants.ts),
  // or the page has a React module of its own, which can notify at any time and
  // whose notifications queue in notifyBus until the host subscribes. A page with
  // a module has an inline module script of its own (this one is excluded by its
  // attribute); a plain Knowledge page has neither, so it skips the download.
  // The old static import also made the browser fetch shared-bundle.js while
  // parsing; now it is requested only after the page has been parsed. Without a
  // hint that put the hero image of the home and services pages 170 ms later and
  // the request form 170 ms later to be ready, so every page with a module
  // preloads it itself (a modulepreload link above its module script). That
  // brings the hero image and the form back on time, makes the catalog ready
  // about 0.7 s sooner than under the old import, and costs a first paint about
  // 120 ms later, because the bundle now shares the connection with the
  // stylesheet and fonts.
  const flashWaiting = (() => {
    try {
      return !!window.sessionStorage.getItem("HC_FLASH_NOTIFICATIONS");
    } catch (e) {
      return true;
    }
  })();
  const hasPageModule = !!document.querySelector(
    'script[type="module"]:not([src]):not([data-toast-host])'
  );
  if (flashWaiting || hasPageModule) {
    const { renderFlashNotifications } = await import("flash-notifications");
    renderFlashNotifications({{json settings}}, {{json help_center.base_locale}});
  }
</script>

